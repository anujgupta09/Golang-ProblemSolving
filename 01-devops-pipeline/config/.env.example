# Copy this file anywhere (outside the repo is safest) and pass its path:
#   bash scripts/one-touch.sh /path/to/my.env      (or set ENV_FILE)
# Default when no path is given: 01-devops-pipeline/config/.env
# The default .env is git-ignored. Never commit real tokens.

## --- Jenkins controller admin ---
JENKINS_ADMIN_USER=admin
# Jenkins' own user database requires 8+ characters.
JENKINS_ADMIN_PASSWORD=

## --- compvalidator-anuj checkout, for the job's own SCM ---
# Must be a classic PAT (repo scope) — fine-grained PATs don't support
# outside-collaborator access to a repo owned by someone else.
PIPELINE_REPO_URL=https://github.com/Udayendu/compvalidator-anuj.git
PIPELINE_REPO_BRANCH=
PIPELINE_REPO_GIT_USERNAME=
PIPELINE_REPO_GIT_TOKEN=

## --- java-maven-sample-app checkout, used by the pipeline itself ---
APP_REPO_URL=https://github.com/anujgupta09/java-maven-sample-app.git
APP_REPO_GIT_USERNAME=
APP_REPO_GIT_TOKEN=

## --- Docker Hub, where the built image is pushed ---
# Where the image is actually pushed (namespace/repo/tag) is controlled by the
# repo's own 01-devops-pipeline/config/release.properties, not by this One Touch setup —
# this just seeds the matching Jenkins credential's username/token.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

## --- Release helper (scripts/version-bump.sh only; ignored by one-touch) ---
# Local checkout of java-maven-sample-app, POSIX path for Git Bash. Keep the quotes: this file is
# sourced by one-touch.sh, and a path with spaces breaks without them.
APP_DIR="/c/path/to/java-maven-sample-app"

## --- Optional overrides — uncomment to change the defaults ---
# PODMAN_MACHINE=podman-machine-default
# JENKINS_PORT=8081
# JOB_NAME=vdx-release
# JOB_SCRIPT_PATH=01-devops-pipeline/Jenkinsfile
# Credential IDs — must match config/release.properties' APP_CREDENTIALS_ID /
# REGISTRY_CREDENTIALS_ID for the pipeline to find them; only change these if
# that file also changes.
# PIPELINE_REPO_CRED_ID=github-compvalidator-anuj-pat
# APP_REPO_CRED_ID=github-java-maven-sample-app-pat
# REGISTRY_CRED_ID=dockerhub-anujdocker9799

## --- Webhook + tunnel ---
# REQUIRED, no default: one-touch.sh stops immediately if either is empty.
# GitHub reaches Jenkins only through the ngrok tunnel.
# APP_REPO_GIT_TOKEN above must also have webhook admin rights on
# APP_REPO_URL (classic PAT with `repo` scope, or a fine-grained PAT with
# Webhooks: read/write).
NGROK_AUTHTOKEN=
# e.g. your-name.ngrok-free.dev
NGROK_DOMAIN=
